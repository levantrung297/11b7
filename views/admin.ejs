<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - 11B7</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
</head>
<body class="bg-slate-100 text-slate-800">

    <!-- Header -->
    <header class="bg-white shadow-sm sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-blue-600 flex items-center justify-center text-white font-bold">11B7</div>
                <h1 class="font-bold text-lg">Quản Trị Website</h1>
            </div>
            <div class="flex items-center gap-4">
                <a href="/" target="_blank" class="text-sm font-medium text-slate-600 hover:text-blue-600"><i class="fa-solid fa-arrow-up-right-from-square"></i> Xem trang chủ</a>
                <a href="/admin/logout" class="px-4 py-2 bg-red-100 text-red-600 rounded-lg font-bold text-sm hover:bg-red-200 transition">Đăng xuất</a>
            </div>
        </div>
    </header>

    <div class="max-w-7xl mx-auto px-4 py-8">
        
        <!-- Tab Navigation -->
        <div class="flex flex-wrap gap-2 mb-8 bg-white p-2 rounded-xl shadow-sm">
            <a href="#members" class="px-4 py-2 bg-blue-50 text-blue-600 rounded-lg font-bold text-sm">Thành viên</a>
            <a href="#gallery" class="px-4 py-2 bg-blue-50 text-blue-600 rounded-lg font-bold text-sm">Thư viện ảnh</a>
            <a href="#schedule" class="px-4 py-2 bg-blue-50 text-blue-600 rounded-lg font-bold text-sm">Lịch học</a>
            <a href="#honors" class="px-4 py-2 bg-blue-50 text-blue-600 rounded-lg font-bold text-sm">Bảng vàng</a>
            <a href="#guestbook" class="px-4 py-2 bg-blue-50 text-blue-600 rounded-lg font-bold text-sm">Lưu bút</a>
        </div>

        <!-- 1. MEMBERS -->
        <section id="members" class="mb-12 bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
            <h2 class="text-xl font-bold text-slate-800 mb-4 border-b pb-2"><i class="fa-solid fa-users text-blue-500"></i> Quản lý Thành Viên</h2>
            
            <form action="/admin/members/add" method="POST" class="grid grid-cols-1 md:grid-cols-5 gap-4 mb-6 bg-slate-50 p-4 rounded-xl">
                <input type="text" name="name" required placeholder="Họ và tên" class="px-3 py-2 rounded-lg border">
                <input type="text" name="nickname" placeholder="Biệt danh / Vai trò" class="px-3 py-2 rounded-lg border">
                <select name="group_name" required class="px-3 py-2 rounded-lg border bg-white">
                    <option value="1">Tổ 1</option><option value="2">Tổ 2</option><option value="3">Tổ 3</option><option value="4">Tổ 4</option>
                </select>
                <input type="text" name="avatar_url" placeholder="Link ảnh (Tùy chọn)" class="px-3 py-2 rounded-lg border">
                <input type="text" name="description" placeholder="Sở thích / Câu nói" class="px-3 py-2 rounded-lg border">
                <button type="submit" class="md:col-span-5 py-2 bg-blue-600 text-white rounded-lg font-bold hover:bg-blue-700">Thêm Thành Viên</button>
            </form>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead class="bg-slate-100 text-slate-600 text-sm">
                        <tr>
                            <th class="p-3">Tên</th>
                            <th class="p-3">Vai trò</th>
                            <th class="p-3">Tổ</th>
                            <th class="p-3">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-sm">
                        <% data.members.forEach(m => { %>
                        <tr class="hover:bg-slate-50">
                            <td class="p-3 font-semibold"><%= m.name %></td>
                            <td class="p-3"><%= m.nickname %></td>
                            <td class="p-3 text-center"><%= m.group_name %></td>
                            <td class="p-3">
                                <form action="/admin/members/delete/<%= m.id %>" method="POST" onsubmit="return confirm('Xóa thành viên này?');">
                                    <button class="text-red-500 hover:bg-red-50 px-2 py-1 rounded"><i class="fa-solid fa-trash"></i> Xóa</button>
                                </form>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- 2. GALLERY -->
        <section id="gallery" class="mb-12 bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
            <h2 class="text-xl font-bold text-slate-800 mb-4 border-b pb-2"><i class="fa-solid fa-image text-pink-500"></i> Quản lý Thư Viện Ảnh</h2>
            
            <form action="/admin/gallery/add" method="POST" class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6 bg-slate-50 p-4 rounded-xl">
                <input type="text" name="title" required placeholder="Tiêu đề ảnh" class="px-3 py-2 rounded-lg border">
                <input type="url" name="image_url" required placeholder="Link ảnh (URL)" class="px-3 py-2 rounded-lg border">
                <select name="category" required class="px-3 py-2 rounded-lg border bg-white">
                    <option value="khaigiang">Khai giảng</option>
                    <option value="vannghe">Văn nghệ</option>
                    <option value="dangoai">Dã ngoại</option>
                    <option value="sinhnhat">Sinh nhật</option>
                </select>
                <button type="submit" class="md:col-span-3 py-2 bg-blue-600 text-white rounded-lg font-bold hover:bg-blue-700">Thêm Ảnh</button>
            </form>

            <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
                <% data.gallery.forEach(g => { %>
                <div class="relative group rounded-xl overflow-hidden border">
                    <img src="<%= g.image_url %>" class="w-full h-24 object-cover" alt="img">
                    <div class="absolute bottom-0 w-full bg-black/60 text-white text-[10px] p-1 truncate"><%= g.title %></div>
                    <form action="/admin/gallery/delete/<%= g.id %>" method="POST" class="absolute top-1 right-1 opacity-0 group-hover:opacity-100 transition" onsubmit="return confirm('Xóa ảnh này?');">
                        <button class="bg-red-500 text-white w-6 h-6 rounded-full flex items-center justify-center hover:bg-red-600"><i class="fa-solid fa-xmark text-xs"></i></button>
                    </form>
                </div>
                <% }) %>
            </div>
        </section>

        <!-- 3. SCHEDULE -->
        <section id="schedule" class="mb-12 bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
            <h2 class="text-xl font-bold text-slate-800 mb-4 border-b pb-2"><i class="fa-solid fa-calendar text-green-500"></i> Quản lý Lịch Học</h2>
            
            <form action="/admin/schedule/add" method="POST" class="grid grid-cols-1 md:grid-cols-5 gap-4 mb-6 bg-slate-50 p-4 rounded-xl">
                <select name="day" required class="px-3 py-2 rounded-lg border bg-white">
                    <option value="T2">Thứ 2</option><option value="T3">Thứ 3</option><option value="T4">Thứ 4</option>
                    <option value="T5">Thứ 5</option><option value="T6">Thứ 6</option><option value="T7">Thứ 7</option>
                </select>
                <input type="number" name="period" required placeholder="Tiết học (1-5)" class="px-3 py-2 rounded-lg border">
                <input type="text" name="time" placeholder="Thời gian (VD: 07:15 - 08:00)" class="px-3 py-2 rounded-lg border">
                <input type="text" name="subject" required placeholder="Môn học" class="px-3 py-2 rounded-lg border">
                <input type="text" name="room" placeholder="Phòng/Ghi chú" class="px-3 py-2 rounded-lg border">
                <button type="submit" class="md:col-span-5 py-2 bg-blue-600 text-white rounded-lg font-bold hover:bg-blue-700">Thêm Tiết Học</button>
            </form>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead class="bg-slate-100 text-slate-600 text-sm">
                        <tr>
                            <th class="p-3">Thứ</th>
                            <th class="p-3">Tiết</th>
                            <th class="p-3">Thời gian</th>
                            <th class="p-3">Môn</th>
                            <th class="p-3">Ghi chú</th>
                            <th class="p-3">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 text-sm">
                        <% data.schedule.forEach(s => { %>
                        <tr class="hover:bg-slate-50">
                            <td class="p-3 font-bold"><%= s.day %></td>
                            <td class="p-3">Tiết <%= s.period %></td>
                            <td class="p-3"><%= s.time %></td>
                            <td class="p-3 font-semibold"><%= s.subject %></td>
                            <td class="p-3"><%= s.room %></td>
                            <td class="p-3">
                                <form action="/admin/schedule/delete/<%= s.id %>" method="POST" onsubmit="return confirm('Xóa tiết này?');">
                                    <button class="text-red-500 hover:bg-red-50 px-2 py-1 rounded"><i class="fa-solid fa-trash"></i> Xóa</button>
                                </form>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- 4. HONORS -->
        <section id="honors" class="mb-12 bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
            <h2 class="text-xl font-bold text-slate-800 mb-4 border-b pb-2"><i class="fa-solid fa-trophy text-amber-500"></i> Quản lý Bảng Vàng</h2>
            
            <form action="/admin/honors/add" method="POST" class="grid grid-cols-1 md:grid-cols-5 gap-4 mb-6 bg-slate-50 p-4 rounded-xl">
                <input type="text" name="name" required placeholder="Tên cá nhân" class="px-3 py-2 rounded-lg border">
                <input type="text" name="title" required placeholder="Thành tích ngắn (VD: Thủ Khoa)" class="px-3 py-2 rounded-lg border">
                <input type="text" name="badge" placeholder="Huy hiệu (VD: 🥇 Thủ Khoa)" class="px-3 py-2 rounded-lg border">
                <input type="text" name="image_url" placeholder="Link ảnh avatar" class="px-3 py-2 rounded-lg border">
                <input type="text" name="description" placeholder="Mô tả chi tiết thành tích" class="px-3 py-2 rounded-lg border">
                <button type="submit" class="md:col-span-5 py-2 bg-blue-600 text-white rounded-lg font-bold hover:bg-blue-700">Thêm Vào Bảng Vàng</button>
            </form>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <% data.honors.forEach(h => { %>
                <div class="flex items-center gap-4 p-4 border rounded-xl relative">
                    <img src="<%= h.image_url || 'https://placehold.co/100x100/2563eb/ffffff' %>" class="w-12 h-12 rounded-full object-cover">
                    <div>
                        <h4 class="font-bold text-slate-800"><%= h.name %> <span class="text-xs bg-amber-100 text-amber-600 px-2 py-0.5 rounded ml-2"><%= h.badge %></span></h4>
                        <p class="text-xs text-slate-500 mt-1"><%= h.description %></p>
                    </div>
                    <form action="/admin/honors/delete/<%= h.id %>" method="POST" class="absolute right-4 top-1/2 -translate-y-1/2" onsubmit="return confirm('Xóa cá nhân này khỏi bảng vàng?');">
                        <button class="text-red-500 hover:bg-red-50 px-2 py-1 rounded"><i class="fa-solid fa-trash"></i></button>
                    </form>
                </div>
                <% }) %>
            </div>
        </section>

        <!-- 5. GUESTBOOK -->
        <section id="guestbook" class="mb-12 bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
            <h2 class="text-xl font-bold text-slate-800 mb-4 border-b pb-2"><i class="fa-solid fa-book-open text-purple-500"></i> Quản lý Lưu Bút</h2>
            
            <div class="space-y-4 max-h-[500px] overflow-y-auto">
                <% data.guestbook.forEach(gb => { %>
                <div class="p-4 border rounded-xl bg-slate-50 flex items-start justify-between">
                    <div>
                        <div class="flex items-center gap-2 mb-1">
                            <span class="font-bold text-sm text-slate-800"><%= gb.name %></span>
                            <span class="text-xs text-slate-500 bg-slate-200 px-2 py-0.5 rounded"><%= gb.group_name %></span>
                            <span class="text-xs text-slate-400 ml-2"><%= new Date(gb.created_at).toLocaleString('vi-VN') %></span>
                        </div>
                        <p class="text-sm text-slate-600"><%= gb.message %></p>
                    </div>
                    <form action="/admin/guestbook/delete/<%= gb.id %>" method="POST" onsubmit="return confirm('Xóa lời nhắn này?');">
                        <button class="text-red-500 hover:bg-red-100 p-2 rounded-lg transition"><i class="fa-solid fa-trash"></i></button>
                    </form>
                </div>
                <% }) %>
                <% if(data.guestbook.length === 0) { %>
                    <p class="text-center text-slate-500 py-4">Chưa có lời chúc nào.</p>
                <% } %>
            </div>
        </section>

    </div>
</body>
</html>
