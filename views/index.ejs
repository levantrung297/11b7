    <!-- JAVASCRIPT LOGIC -->
    <script>
        /* ----------------------------------------------------
         1. DATA DEFINITIONS (Members, Gallery, Timetable, Audio)
        ---------------------------------------------------- */
        
        // Members List (4 Tổ)
        const membersData = <%- JSON.stringify(data.members || []) %>;

        // Gallery Photos Data
        const galleryData = <%- JSON.stringify(data.gallery || []) %>;

        // Timetable Data
        const timetableDataRaw = <%- JSON.stringify(data.schedule || []) %>;
        const timetableData = {"T2":[],"T3":[],"T4":[],"T5":[],"T6":[],"T7":[]};
        timetableDataRaw.forEach(item => timetableData[item.day].push(item));

        // Music Playlist (Sử dụng nhạc royalty free audio sample)
        const playlist = [
            { title: "Sống Hết Mình Tuổi Trẻ", artist: "Nhạc Tuổi Học Trò 11B7", src: "https://cdn.pixabay.com/download/audio/2022/05/27/audio_1808fbf07a.mp3?filename=upbeat-pop-112191.mp3" },
            { title: "Kỷ Niệm Mái Trường", artist: "Hải Phòng Melodies", src: "https://cdn.pixabay.com/download/audio/2022/01/18/audio_d0a13f69d2.mp3?filename=inspiring-cinematic-ambient-116199.mp3" }
        ];

        /* ----------------------------------------------------
         2. INITIALIZATION & STATE
        ---------------------------------------------------- */
        let currentGroupFilter = 'all';
        let currentSongIndex = 0;
        let isPlaying = false;

        document.addEventListener('DOMContentLoaded', () => {
            renderMembers();
            renderGallery('all');
            renderSchedule('T2');
            initCountdown();
            loadGuestbook();
            initAudio();
        });

        /* ----------------------------------------------------
         3. DARK/LIGHT MODE TOGGLE
        ---------------------------------------------------- */
        function toggleTheme() {
            document.documentElement.classList.toggle('dark');
        }

        function toggleMobileMenu() {
            const menu = document.getElementById('mobileMenu');
            menu.classList.toggle('hidden');
        }

        /* ----------------------------------------------------
         4. MEMBERS DIRECTORY FUNCTIONS
        ---------------------------------------------------- */
        function setGroupFilter(group) {
            currentGroupFilter = group;
            
            // Active button UI update
            document.querySelectorAll('.group-btn').forEach(btn => {
                if (btn.getAttribute('data-group') === group.toString()) {
                    btn.classList.add('bg-blue-600', 'text-white');
                    btn.classList.remove('text-slate-600', 'dark:text-slate-300', 'hover:bg-slate-100');
                } else {
                    btn.classList.remove('bg-blue-600', 'text-white');
                    btn.classList.add('text-slate-600', 'dark:text-slate-300');
                }
            });

            filterMembers();
        }

        function filterMembers() {
            const searchTerm = document.getElementById('memberSearch').value.toLowerCase();
            const grid = document.getElementById('membersGrid');
            
            const filtered = membersData.filter(m => {
                const matchesGroup = (currentGroupFilter === 'all') || (m.group_name.toString() === currentGroupFilter);
                const matchesSearch = m.name.toLowerCase().includes(searchTerm) || m.nick.toLowerCase().includes(searchTerm);
                return matchesGroup && matchesSearch;
            });

            if (filtered.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full text-center py-12 text-slate-400">
                        <i class="fa-solid fa-user-slash text-4xl mb-3"></i>
                        <p class="text-sm font-semibold">Không tìm thấy thành viên phù hợp!</p>
                    </div>
                `;
                return;
            }

            grid.innerHTML = filtered.map(m => `
                <div class="glass-card rounded-3xl p-5 relative group hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between border border-slate-200/80 dark:border-slate-800">
                    <div>
                        <!-- Card Header Top -->
                        <div class="flex items-center justify-between mb-4">
                            <span class="text-[10px] font-extrabold uppercase px-2.5 py-1 rounded-full bg-blue-100 dark:bg-blue-900/50 text-blue-600 dark:text-blue-300">
                                ${m.group_name}
                            </span>
                            <span class="text-xs font-semibold text-slate-400">
                                ${m.nickname || ''}
                            </span>
                        </div>

                        <!-- Image & Basic Info -->
                        <div class="text-center mb-4">
                            <div class="relative w-20 h-20 mx-auto mb-3">
                                <img src="${m.avatar_url || 'https://placehold.co/200x200/2563eb/ffffff?text=' + encodeURIComponent(m.name)}" alt="${m.name}" class="w-full h-full object-cover rounded-2xl shadow-md group-hover:scale-105 transition-transform duration-300"
                                     onerror="this.src='https://placehold.co/200x200/2563eb/ffffff?text=${encodeURIComponent(m.name)}'">
                            </div>
                            <h3 class="font-bold text-slate-900 dark:text-white text-base leading-snug">${m.name}</h3>
                            <p class="text-xs text-amber-500 font-medium mt-0.5">"${m.nick}"</p>
                        </div>
                    </div>

                    <!-- Action Button -->
                    <button onclick="openMemberModal(${m.id})" class="w-full py-2 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-blue-600 hover:text-white dark:hover:bg-blue-600 text-slate-700 dark:text-slate-200 text-xs font-bold transition-all flex items-center justify-center gap-1.5 mt-2">
                        <i class="fa-solid fa-id-card"></i> Xem chi tiết
                    </button>
                </div>
            `).join('');
        }

        function renderMembers() {
            filterMembers();
        }

        function openMemberModal(id) {
            const m = membersData.find(item => item.id === id);
            if (!m) return;

            const modalBody = document.getElementById('modalBody');
            modalBody.innerHTML = `
                <div class="text-center">
                    <img src="${m.avatar_url || 'https://placehold.co/200x200/2563eb/ffffff?text=' + encodeURIComponent(m.name)}" alt="${m.name}" class="w-24 h-24 object-cover rounded-3xl mx-auto shadow-lg mb-4 border-2 border-blue-500"
                         onerror="this.src='https://placehold.co/200x200/2563eb/ffffff?text=${encodeURIComponent(m.name)}'">
                    <span class="px-3 py-1 rounded-full bg-blue-100 dark:bg-blue-900/50 text-blue-600 dark:text-blue-300 text-xs font-bold uppercase">
                        ${m.group_name} • ${m.nickname || ''}
                    </span>
                    <h3 class="text-2xl font-extrabold text-slate-900 dark:text-white mt-2">${m.name}</h3>
                    <p class="text-sm font-semibold text-amber-500 mb-4">Biệt danh: "${m.nick}"</p>
                    
                    <div class="space-y-3 text-left bg-slate-50 dark:bg-slate-800/60 p-4 rounded-2xl text-xs sm:text-sm">
                        <div class="flex items-start gap-2">
                            <i class="fa-solid fa-heart text-pink-500 mt-1"></i>
                            <div>
                                <strong class="text-slate-800 dark:text-slate-200">Sở thích:</strong>
                                <p class="text-slate-600 dark:text-slate-400">${m.description || 'Không có'}</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-2">
                            <i class="fa-solid fa-quote-left text-blue-500 mt-1"></i>
                            <div>
                                <strong class="text-slate-800 dark:text-slate-200">Câu nói yêu thích:</strong>
                                <p class="text-slate-600 dark:text-slate-400 italic font-medium">${m.description || 'Không có'}</p>
                            </div>
                        </div>
                    </div>
                </div>
            `;

            const modal = document.getElementById('memberModal');
            const content = document.getElementById('memberModalContent');
            modal.classList.remove('opacity-0', 'pointer-events-none');
            content.classList.remove('scale-95');
            content.classList.add('scale-100');
        }

        function closeMemberModal() {
            const modal = document.getElementById('memberModal');
            const content = document.getElementById('memberModalContent');
            content.classList.remove('scale-100');
            content.classList.add('scale-95');
            modal.classList.add('opacity-0', 'pointer-events-none');
        }

        /* ----------------------------------------------------
         5. GALLERY & LIGHTBOX FUNCTIONS
        ---------------------------------------------------- */
        function renderGallery(cat) {
            const grid = document.getElementById('galleryGrid');
            const filtered = (cat === 'all') ? galleryData : galleryData.filter(g => g.category === cat);

            grid.innerHTML = filtered.map(g => `
                <div onclick="openLightbox('${g.img}', '${g.title}')" class="group relative rounded-2xl overflow-hidden cursor-pointer shadow-sm hover:shadow-xl transition duration-300 bg-slate-800 aspect-video sm:aspect-square">
                    <img src="${g.img}" alt="${g.title}" class="w-full h-full object-cover group-hover:scale-110 transition duration-500">
                    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition duration-300 flex items-end p-4">
                        <p class="text-white text-xs font-bold">${g.title}</p>
                    </div>
                </div>
            `).join('');
        }

        function filterGallery(cat) {
            document.querySelectorAll('.gallery-tab').forEach(tab => {
                if(tab.getAttribute('data-cat') === cat) {
                    tab.classList.add('bg-blue-600', 'text-white');
                    tab.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
                } else {
                    tab.classList.remove('bg-blue-600', 'text-white');
                    tab.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
                }
            });
            renderGallery(cat);
        }

        function openLightbox(imgUrl, caption) {
            const modal = document.getElementById('lightboxModal');
            document.getElementById('lightboxImg').src = imgUrl;
            document.getElementById('lightboxCaption').innerText = caption;
            modal.classList.remove('opacity-0', 'pointer-events-none');
        }

        function closeLightbox() {
            document.getElementById('lightboxModal').classList.add('opacity-0', 'pointer-events-none');
        }

        /* ----------------------------------------------------
         6. TIMETABLE & COUNTDOWN
        ---------------------------------------------------- */
        function renderSchedule(dayKey) {
            // Tab highlight
            document.querySelectorAll('.sched-btn').forEach(btn => {
                if(btn.getAttribute('data-day') === dayKey) {
                    btn.classList.add('bg-blue-600', 'text-white');
                    btn.classList.remove('text-slate-600', 'dark:text-slate-300');
                } else {
                    btn.classList.remove('bg-blue-600', 'text-white');
                    btn.classList.add('text-slate-600', 'dark:text-slate-300');
                }
            });

            const tbody = document.getElementById('scheduleBody');
            const dayData = timetableData[dayKey] || [];

            tbody.innerHTML = dayData.map(item => `
                <tr class="hover:bg-slate-100/50 dark:hover:bg-slate-800/40 transition">
                    <td class="py-3 px-4 font-bold text-blue-600 dark:text-blue-400">Tiết ${item.period}</td>
                    <td class="py-3 px-4 text-xs font-medium text-slate-500 dark:text-slate-400">${item.time}</td>
                    <td class="py-3 px-4 font-semibold text-slate-800 dark:text-slate-100">${item.subject}</td>
                    <td class="py-3 px-4 text-xs text-slate-500 dark:text-slate-400">${item.note}</td>
                </tr>
            `).join('');
        }

        function initCountdown() {
            // Target Date (20 days from current date)
            const targetDate = new Date();
            targetDate.setDate(targetDate.getDate() + 14);

            function update() {
                const now = new Date();
                const diff = targetDate - now;

                if (diff <= 0) return;

                const days = Math.floor(diff / (1000 * 60 * 60 * 24));
                const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
                const mins = Math.floor((diff / 1000 / 60) % 60);
                const secs = Math.floor((diff / 1000) % 60);

                document.getElementById('cdDays').innerText = days < 10 ? '0' + days : days;
                document.getElementById('cdHours').innerText = hours < 10 ? '0' + hours : hours;
                document.getElementById('cdMins').innerText = mins < 10 ? '0' + mins : mins;
                document.getElementById('cdSecs').innerText = secs < 10 ? '0' + secs : secs;
            }

            update();
            setInterval(update, 1000);
        }

        /* ----------------------------------------------------
         7. GUESTBOOK / MEMORY WALL (LOCALSTORAGE)
        ---------------------------------------------------- */
        const defaultMessages = <%- JSON.stringify(data.guestbook || []) %>;

        function loadGuestbook() {
            const messages = defaultMessages;

            document.getElementById('guestbookCount').innerText = `${messages.length} lời nhắn`;
            const feed = document.getElementById('guestbookFeed');

            feed.innerHTML = messages.map(m => `
                <div class="glass-card p-4 rounded-2xl border border-slate-200 dark:border-slate-800 space-y-2 animate-fade-in">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-blue-500 to-indigo-500 text-white font-bold flex items-center justify-center text-xs">
                                ${m.name.charAt(0)}
                            </div>
                            <div>
                                <h5 class="font-bold text-xs text-slate-800 dark:text-slate-100">${m.name}</h5>
                                <span class="text-[10px] text-blue-600 dark:text-blue-400 font-medium">${m.group}</span>
                            </div>
                        </div>
                        <span class="text-[10px] text-slate-400">${new Date(m.created_at).toLocaleDateString('vi-VN') || 'Vừa xong'}</span>
                    </div>
                    <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">${m.message}</p>
                </div>
            `).join('');
        }



        /* ----------------------------------------------------
         8. MUSIC PLAYER
        ---------------------------------------------------- */
        function initAudio() {
            const audio = document.getElementById('bgAudio');
            audio.src = playlist[currentSongIndex].src;
            updateSongDisplay();
        }

        function updateSongDisplay() {
            const song = playlist[currentSongIndex];
            document.getElementById('songTitle').innerText = song.title;
            document.getElementById('songArtist').innerText = song.artist;
        }

        function togglePlay() {
            const audio = document.getElementById('bgAudio');
            const icon = document.getElementById('playIcon');
            const disk = document.getElementById('musicDisk');

            if (isPlaying) {
                audio.pause();
                icon.className = "fa-solid fa-play text-xs";
                disk.classList.remove('animate-spin');
            } else {
                audio.play().then(() => {
                    icon.className = "fa-solid fa-pause text-xs";
                    disk.classList.add('animate-spin');
                }).catch(err => console.log("Audio playback blocked by browser policies"));
            }
            isPlaying = !isPlaying;
        }

        function nextSong() {
            currentSongIndex = (currentSongIndex + 1) % playlist.length;
            const audio = document.getElementById('bgAudio');
            audio.src = playlist[currentSongIndex].src;
            updateSongDisplay();
            if (isPlaying) audio.play();
        }

        function prevSong() {
            currentSongIndex = (currentSongIndex - 1 + playlist.length) % playlist.length;
            const audio = document.getElementById('bgAudio');
            audio.src = playlist[currentSongIndex].src;
            updateSongDisplay();
            if (isPlaying) audio.play();
        }
    </script>
</body>
</html>